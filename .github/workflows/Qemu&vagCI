name: QEMU / Vagrant CI (Dirty COW Test)

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]
  workflow_dispatch: # Allows you to manually trigger the pipeline from the GitHub UI

jobs:
  exploit-test-vm:
    runs-on: ubuntu-latest
    
    steps:
    - uses: actions/checkout@v4
    
    - name: Install QEMU and Vagrant
      run: |
        sudo apt-get update
        sudo apt-get install -y qemu-system-x86 qemu-utils
        
        # Install Vagrant
        curl -fsSL https://apt.releases.hashicorp.com/gpg | sudo gpg --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg
        echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" | sudo tee /etc/apt/sources.list.d/hashicorp.list
        sudo apt-get update && sudo apt-get install -y vagrant virtualbox
        
    - name: Create Vagrantfile for Vulnerable Environment
      run: |
        cat <<EOF > Vagrantfile
        Vagrant.configure("2") do |config|
          # Using an older box known to be unpatched for Dirty COW (CVE-2016-5195)
          # e.g., an older Ubuntu 14.04 (Trusty) release prior to October 2016
          config.vm.box = "ubuntu/trusty64"
          config.vm.box_version = "20160822.0.0" 
          
          # Sync the current repository into the VM
          config.vm.synced_folder ".", "/vagrant"
          
          config.vm.provision "shell", inline: <<-SHELL
            echo "--- Inside VM: Kernel Version ---"
            uname -r
            
            echo "--- Compiling and running Dirty COW inside the vulnerable VM ---"
            cd /vagrant
            # If your script compiles and runs the exploit: 
            # bash scripts/test_dirty_cow.sh
            
            # For demonstration:
            echo "Logs will be captured here." > /vagrant/dirty_cow_exploit.log
            echo "Mitigation verified." > /vagrant/dirty_cow_mitigation.log
          SHELL
        end
        EOF

    - name: Run Vagrant Environment
      run: |
        # Boot up the VM (Note: without KVM hardware acceleration this relies on software emulation / VirtualBox nested virtualization)
        vagrant up
        
    - name: Upload Logs from VM
      uses: actions/upload-artifact@v4
      if: always() # Run this even if the exploit compilation/execution fails
      with:
        name: vm-dirty-cow-logs
        path: |
          dirty_cow_exploit.log
          dirty_cow_mitigation.log
